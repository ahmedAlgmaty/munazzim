generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// المهمة — قلب منظّم
model Task {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  priority    String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  scope       String    @default("DAY") // DAY | WEEK | MONTH
  status      String    @default("OPEN") // OPEN | DONE
  completedAt DateTime?
  pomodoros   Int       @default(0)
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// الرؤية الشخصية — خانة واحدة قابلة للكتابة
model Vision {
  id        String   @id @default("main")
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

// الهدف الكبير — ماجستير، مشروع جديد...
model Goal {
  id         String      @id @default(cuid())
  title      String
  horizon    String      @default("1Y") // 1Y | 3Y | 5Y
  targetDate DateTime?
  achieved   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  milestones Milestone[]
  tasks      Task[]
}

// مرحلة ضمن الهدف الكبير
model Milestone {
  id     String  @id @default(cuid())
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)
  goalId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

// الإعدادات العامة
model Setting {
  id            String @id @default("main")
  language      String @default("ar") // ar | en
  pomodoroWork  Int    @default(25)
  pomodoroBreak Int    @default(5)
}
